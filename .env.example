NODE_ENV=development
PORT=4000
# Relative to the project root
DATABASE_URL=./data/database.sqlite
# 32+ random chars in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
# Local development values. Production example: https://api.mytryon.com and https://cdn.mytryon.com
SDK_API_URL=http://localhost:4000
SDK_CDN_URL=http://localhost:4000/cdn
# Set true behind HTTPS (automatic in production)
COOKIE_SECURE=false
# Number of reverse-proxy hops (e.g. 1 behind nginx) so rate limiting sees real IPs
TRUST_PROXY=
# Seeds demo API key vto_demo_localkey_0001 for localhost (ignored in production)
SEED_DEMO=true

# --- Product-image fetch (only used for images the browser cannot read itself, i.e. no CORS headers) ---
# Besides each client's own allowed domains, these CDN hosts (comma separated, subdomains included) may be fetched.
# Example: cdn.shopify.com,images.example-cdn.com . Empty = only the client's own domains.
IMAGE_PROXY_EXTRA_HOSTS=
# Development only (ignored in production): allow http:// image URLs.
IMAGE_PROXY_ALLOW_HTTP=false
